{
  "name": "sigmora-live-relay-webmcp",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source WebMCP reference implementation for Sigmora Live Relay.",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "build": "pnpm --filter @sigmora/live-relay-webmcp build && pnpm --filter @sigmora/live-relay-reference build",
    "dev": "pnpm --filter @sigmora/live-relay-reference dev",
    "test": "pnpm --filter @sigmora/live-relay-webmcp test",
    "typecheck": "pnpm --filter @sigmora/live-relay-webmcp typecheck && pnpm --filter @sigmora/live-relay-reference typecheck",
    "test:e2e": "playwright test",
    "evidence:screenshot": "playwright test tests/evidence.spec.ts --workers=1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1"
  }
}
